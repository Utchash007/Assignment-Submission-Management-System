# =================================================================
# Root Environment Configuration Template
# Copy this file to .env (which is ignored by git) for local Docker Compose
# =================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=onnorokom_asm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Backend Database Connection (JDBC URL, for Docker network host is 'postgres')
# The backend runs ddl-auto=validate: create the schema once first (EF migration
# SQL), then DataSeeder provisions demo data on first boot automatically.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/onnorokom_asm

# JWT Authentication Secrets
JWT_ISSUER=OnnoRokomBackend
JWT_AUDIENCE=OnnoRokomFrontend
JWT_SIGNING_KEY=your_super_secret_production_signing_key_min_32_chars_here

# Service Ports & Settings
BACKEND_PORT=5000
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xmx384m
NODE_ENV=production

# Frontend Backend Communication
INTERNAL_BACKEND_URL=http://backend:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
